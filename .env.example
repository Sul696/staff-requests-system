# انسخ هذا الملف باسم .env وعدّل القيم قبل التشغيل
PORT=3000

# مفتاح تشفير التوكن - استخدم نصًا عشوائيًا طويلًا وغير قابل للتخمين
JWT_SECRET=change_this_to_a_long_random_secret_key_before_deployment
JWT_EXPIRES_IN=8h

# بيانات حساب المسؤول الذي يُنشأ تلقائيًا عند أول تشغيل للنظام
ADMIN_NAME=مسؤول النظام
ADMIN_EMAIL=admin@moe.gov.sa
ADMIN_PASSWORD=Admin@12345
ADMIN_DEPARTMENT=إدارة تقنية المعلومات

# قاعدة البيانات (اختياري) — إن تُركت فارغة، يعمل النظام على ملف SQLite محلي (requests.db)،
# مناسب تمامًا للتشغيل على جهازك. أما على استضافة سحابية مجانية (مثل Render) فالتخزين المحلي
# يُمسح مع كل إعادة نشر — لذلك عند النشر أضف بيانات Turso هنا للحصول على قاعدة بيانات دائمة:
# 1) أنشئ حسابًا مجانيًا على turso.tech
# 2) أنشئ قاعدة بيانات جديدة من لوحة التحكم
# 3) انسخ "Database URL" و "Auth Token" وضعهما هنا
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# إعدادات بريد التحقق (اختيارية) — إن تُركت فارغة، يعمل النظام في "وضع العرض التجريبي":
# رمز التفعيل يظهر مباشرة في الواجهة بدل إرساله بالبريد الفعلي (مناسب لعرض المشروع التدريبي).
#
# مهم: نستخدم Brevo عبر HTTPS API (وليس SMTP) لأن منصات الاستضافة المجانية (مثل Render)
# تمنع أي اتصال SMTP صادر. احصل على المفتاح من: Brevo -> SMTP & API -> تبويب "API Keys"
# (هذا مفتاح مختلف عن "مفتاح SMTP" القديم — لازم يكون من تبويب API Keys تحديدًا)
BREVO_API_KEY=
SMTP_FROM=
